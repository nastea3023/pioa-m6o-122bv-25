  input  logic                          tready_m_i[OUT_NUM],
  // APB
  input  logic[APB_PPADDR_WIDTH-1:0]    paddr_i,
  input  logic[APB_PDATA_WIDTH-1:0]     pwdata_i,
  output logic[APB_PDATA_WIDTH-1:0]     prdata_o,
  input  logic                          psel_i,
  input  logic                          penable_i,
  output logic                          pready_o,
  input  logic                          pwrite_i,
  output logic                          pslverr_o,
  // Interrupt
  output logic                          irq_o
);
